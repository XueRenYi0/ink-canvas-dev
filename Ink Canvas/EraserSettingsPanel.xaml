<UserControl x:Class="Ink_Canvas.EraserSettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Microsoft YaHei UI">
    <!-- ============================================================
         橡皮设置面板：点橡皮图标弹出，点面板外任意处消失。
         分区（自上而下）：擦除方式（面积擦/笔画擦）→ 大小（五档）→ 滑动清屏。
         - 选中态统一：淡蓝底 + 蓝边（与笔面板/选择面板同款规范）
         - 面板圆角 5、控件圆角 4、图标描边 IconStroke 1.22（InkSpec.xaml 规范）
         - 大小档位示意：黄金比矩形轮廓（宽:高 = 1:1.618，与实际橡皮形状一致）逐档放大
         - 笔画擦时大小区灰显禁用（笔画擦无大小概念，碰到墨迹即删整笔）
         - 滑动清屏（ClassIn 式）：滑块拖到最右触发，中途松手回弹；防误触替代确认弹窗
         - 交互事件通过 code-behind 抛给 MainWindow 订阅（EraserModeSelected 等）
         ============================================================ -->
    <UserControl.Resources>
        <!-- 选中态淡蓝底（约 15% 不透明度，与笔面板高亮同色系） -->
        <SolidColorBrush x:Key="EraserPanelSoftHighlight" Color="#260088FF"/>
    </UserControl.Resources>

    <Border CornerRadius="5" Background="{DynamicResource FloatBarBackground}"
            BorderBrush="{DynamicResource FloatBarBorderBrush}" BorderThickness="1"
            HorizontalAlignment="Left" VerticalAlignment="Top">
        <StackPanel Margin="10,8,10,8">

            <!-- ===== 分区一：擦除方式（面积擦 / 笔画擦）=====
                 面积擦：黄金比矩形橡皮轮廓，按面积逐点擦除（可精细雕刻）
                 笔画擦：橡皮+波浪笔画装饰（与浮动条笔画擦图标同语义），碰到的墨迹整笔删除 -->
            <UniformGrid Rows="1" Columns="2">
                <Grid x:Name="BorderModePoint" Width="76" Height="46" Background="Transparent"
                      MouseUp="ModeButton_MouseUp" ToolTip="面积擦&#10;按橡皮面积逐点擦除，适合精细修整&#10;大小可选五档">
                    <Border x:Name="ModePointHighlight" CornerRadius="4" Margin="1"
                            Background="Transparent" BorderBrush="Transparent" BorderThickness="1.5"/>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <!-- 面积擦图标：黄金比矩形橡皮轮廓（宽:高=1:1.618） -->
                        <Path Data="M4,4 H11 V19.85 H4 Z"
                              Stroke="{DynamicResource FloatBarForeground}" StrokeThickness="{StaticResource IconStroke}"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Width="13" Height="18" Stretch="Uniform"/>
                        <TextBlock Text="面积擦" FontSize="10" Foreground="{DynamicResource FloatBarForeground}"
                                   HorizontalAlignment="Center" Margin="0,3,0,0"/>
                    </StackPanel>
                </Grid>
                <Grid x:Name="BorderModeStroke" Width="76" Height="46" Background="Transparent"
                      MouseUp="ModeButton_MouseUp" ToolTip="笔画擦&#10;碰到的墨迹整笔删除，适合快速清掉写错的整句话&#10;无大小概念">
                    <Border x:Name="ModeStrokeHighlight" CornerRadius="4" Margin="1"
                            Background="Transparent" BorderBrush="Transparent" BorderThickness="1.5"/>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <!-- 笔画擦图标：小橡皮 + 波浪笔画（波浪=被擦除的墨迹） -->
                        <Grid Width="16" Height="16">
                            <Path Data="M2,13.5 L5.5,10 L11,15.5 L7.5,19 Z"
                                  Stroke="{DynamicResource FloatBarForeground}" StrokeThickness="{StaticResource IconStroke}"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            <Path Data="M8,5 C10,3 12,7 14,5"
                                  Stroke="{DynamicResource FloatBarForeground}" StrokeThickness="{StaticResource IconStroke}"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeDashArray="2,1.5"/>
                        </Grid>
                        <TextBlock Text="笔画擦" FontSize="10" Foreground="{DynamicResource FloatBarForeground}"
                                   HorizontalAlignment="Center" Margin="0,3,0,0"/>
                    </StackPanel>
                </Grid>
            </UniformGrid>

            <!-- 分隔线 -->
            <Border Height="1" Background="{DynamicResource FloatBarForeground}" Opacity="0.2" Margin="2,6,2,6"/>

            <!-- ===== 分区二：大小（五档，黄金比矩形示意逐档放大）=====
                 档位宽度：30 / 45 / 60 / 80 / 100（实际橡皮高 = 宽 × 1.618）
                 档位示意：描边矩形按黄金比缩小展示，与真实橡皮形状一致 -->
            <UniformGrid Rows="1" Columns="5">
                <Grid x:Name="BorderSize1" Width="34" Height="32" Background="Transparent"
                      MouseUp="SizeButton_MouseUp" ToolTip="橡皮大小：30 × 48（最小）">
                    <Border x:Name="Size1Highlight" CornerRadius="4" Margin="1"
                            Background="Transparent" BorderBrush="Transparent" BorderThickness="1.5"/>
                    <Path Data="M0,0 H5 V8 H0 Z" Stroke="{DynamicResource FloatBarForeground}"
                          StrokeThickness="{StaticResource IconStroke}" Stretch="None"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                </Grid>
                <Grid x:Name="BorderSize2" Width="34" Height="32" Background="Transparent"
                      MouseUp="SizeButton_MouseUp" ToolTip="橡皮大小：45 × 73">
                    <Border x:Name="Size2Highlight" CornerRadius="4" Margin="1"
                            Background="Transparent" BorderBrush="Transparent" BorderThickness="1.5"/>
                    <Path Data="M0,0 H7 V11 H0 Z" Stroke="{DynamicResource FloatBarForeground}"
                          StrokeThickness="{StaticResource IconStroke}" Stretch="None"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                </Grid>
                <Grid x:Name="BorderSize3" Width="34" Height="32" Background="Transparent"
                      MouseUp="SizeButton_MouseUp" ToolTip="橡皮大小：60 × 97（中）">
                    <Border x:Name="Size3Highlight" CornerRadius="4" Margin="1"
                            Background="Transparent" BorderBrush="Transparent" BorderThickness="1.5"/>
                    <Path Data="M0,0 H9 V14.5 H0 Z" Stroke="{DynamicResource FloatBarForeground}"
                          StrokeThickness="{StaticResource IconStroke}" Stretch="None"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                </Grid>
                <Grid x:Name="BorderSize4" Width="34" Height="32" Background="Transparent"
                      MouseUp="SizeButton_MouseUp" ToolTip="橡皮大小：80 × 129">
                    <Border x:Name="Size4Highlight" CornerRadius="4" Margin="1"
                            Background="Transparent" BorderBrush="Transparent" BorderThickness="1.5"/>
                    <Path Data="M0,0 H11.5 V18.5 H0 Z" Stroke="{DynamicResource FloatBarForeground}"
                          StrokeThickness="{StaticResource IconStroke}" Stretch="None"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                </Grid>
                <Grid x:Name="BorderSize5" Width="34" Height="32" Background="Transparent"
                      MouseUp="SizeButton_MouseUp" ToolTip="橡皮大小：100 × 162（最大）">
                    <Border x:Name="Size5Highlight" CornerRadius="4" Margin="1"
                            Background="Transparent" BorderBrush="Transparent" BorderThickness="1.5"/>
                    <Path Data="M0,0 H14 V22.5 H0 Z" Stroke="{DynamicResource FloatBarForeground}"
                          StrokeThickness="{StaticResource IconStroke}" Stretch="None"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                </Grid>
            </UniformGrid>

            <!-- 分隔线 -->
            <Border Height="1" Background="{DynamicResource FloatBarForeground}" Opacity="0.2" Margin="2,6,2,6"/>

            <!-- ===== 分区三：滑动清屏（ClassIn 式）=====
                 滑块拖到最右（≥85%）触发清屏，中途松手回弹；替代原"点击清屏+确认"两步交互。
                 触发后面板自动收起。清屏逻辑（自动截图/切回画笔）由 MainWindow 处理；
                 删除选中墨迹走选中操作条的删除按钮，不在此处 -->
            <Grid x:Name="SlideClearTrack" Height="30" Margin="2,0,2,0" Background="Transparent"
                  ToolTip="滑动清屏（滑到最右执行，中途松手回弹）&#10;清除当前页全部墨迹与图片，清屏后切回画笔&#10;删除部分墨迹请用选择工具选中后操作">
                <!-- 轨道底：浅色圆角胶囊 -->
                <Border CornerRadius="15" Background="{DynamicResource FloatBarForeground}" Opacity="0.12"/>
                <!-- 轨道提示文字（滑块滑过时被遮住，自然露出） -->
                <TextBlock Text="滑动清屏 ⟩⟩" FontSize="10" Foreground="{DynamicResource FloatBarForeground}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.8"
                           IsHitTestVisible="False"/>
                <!-- 滑块：蓝色圆钮 + 右向箭头；TranslateTransform 控制位置（回弹动画作用于它） -->
                <Border x:Name="SlideClearThumb" Width="26" Height="26" CornerRadius="13"
                        Background="{DynamicResource HighlightBrush}" HorizontalAlignment="Left"
                        VerticalAlignment="Center" Margin="2,0,0,0" Cursor="Hand"
                        MouseLeftButtonDown="SlideThumb_MouseLeftButtonDown"
                        MouseLeftButtonUp="SlideThumb_MouseLeftButtonUp"
                        MouseMove="SlideThumb_MouseMove">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="SlideThumbTranslate" X="0"/>
                    </Border.RenderTransform>
                    <Path Data="M7,6 L12,13 L7,20" Stroke="White" StrokeThickness="1.8"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
