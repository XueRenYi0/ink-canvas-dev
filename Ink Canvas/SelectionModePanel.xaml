<UserControl x:Class="Ink_Canvas.SelectionModePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Microsoft YaHei UI">
    <!-- ============================================================
         选择方式面板：点"选择墨迹"图标弹出，选择后自动关闭。
         竖排三项：矩形框选（默认）/ 自由选择（套索）/ 全选（动作）。
         - 前两项是"方式"（有选中态高亮）；全选是"动作"（点完即关，无选中态）
         - 竖排布局：与截图菜单同款列表语义，宽度窄不挡板书
         - 选中态：淡蓝底 + 蓝边（与笔面板 PenPanelSoftHighlight 同规范）
         - 面板圆角 5、控件圆角 4、图标描边 IconStroke（InkSpec.xaml 规范）
         - 纯 UI 组件：动作通过事件抛给 MainWindow 订阅，自身不碰 inkCanvas
         ============================================================ -->
    <UserControl.Resources>
        <!-- 选中态淡蓝底（约 15% 不透明度，与笔面板/浮动条高亮同色系） -->
        <SolidColorBrush x:Key="SelPanelSoftHighlight" Color="#260088FF"/>
    </UserControl.Resources>

    <Border CornerRadius="5" Background="{DynamicResource FloatBarBackground}"
            BorderBrush="{DynamicResource FloatBarBorderBrush}" BorderThickness="1"
            HorizontalAlignment="Left" VerticalAlignment="Top">
        <StackPanel Margin="6,5,6,5">
            <!-- 矩形框选 -->
            <Grid x:Name="BorderModeRect" Height="30" Width="112" Background="Transparent"
                  MouseUp="ModeButton_MouseUp" ToolTip="矩形框选&#10;按住拖出矩形，选中框内全部墨迹">
                <Border x:Name="ModeRectHighlight" CornerRadius="4" Margin="1"
                        Background="Transparent" BorderBrush="Transparent" BorderThickness="1.5"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                    <!-- 矩形框选图标：虚线矩形（与选择墨迹主图标的框一致） -->
                    <Path Data="M3,4 H16 V15 H3 Z"
                          Stroke="{DynamicResource FloatBarForeground}" StrokeThickness="{StaticResource IconStroke}"
                          StrokeDashArray="2.8,2.2"
                          Width="14" Height="14" Stretch="Uniform"/>
                    <TextBlock Text="矩形框选" FontSize="11" Foreground="{DynamicResource FloatBarForeground}"
                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>
            </Grid>

            <!-- 自由选择（套索） -->
            <Grid x:Name="BorderModeLasso" Height="30" Width="112" Background="Transparent"
                  MouseUp="ModeButton_MouseUp" ToolTip="自由选择&#10;按住拖画任意闭合区域，选中圈住/碰到的墨迹">
                <Border x:Name="ModeLassoHighlight" CornerRadius="4" Margin="1"
                        Background="Transparent" BorderBrush="Transparent" BorderThickness="1.5"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                    <!-- 套索图标：不规则闭合曲线 + 中间墨迹点 -->
                    <Grid Width="14" Height="14">
                        <Path Data="M7,2 C11,2 13,4.5 12.5,7.5 C12,10.5 9.5,12.5 6.5,12 C3.5,11.5 1.5,9.5 2,6.5 C2.5,4 4.5,2 7,2 Z"
                              Stroke="{DynamicResource FloatBarForeground}" StrokeThickness="{StaticResource IconStroke}"
                              StrokeDashArray="2.2,1.8" Fill="Transparent"/>
                        <Ellipse Width="3" Height="3" Fill="{DynamicResource FloatBarForeground}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock Text="自由选择" FontSize="11" Foreground="{DynamicResource FloatBarForeground}"
                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>
            </Grid>

            <!-- 分隔线：前两项是"方式"，全选是"动作"，视觉上分组 -->
            <Border Height="1" Background="{DynamicResource FloatBarForeground}" Opacity="0.2" Margin="4,3,4,3"/>

            <!-- 全选（动作：点击即全选当前页全部墨迹并关闭面板） -->
            <Grid x:Name="BorderModeSelectAll" Height="30" Width="112" Background="Transparent"
                  MouseUp="SelectAllButton_MouseUp" ToolTip="全选&#10;选中当前页全部墨迹（原双击选择图标的旧功能）">
                <Border x:Name="ModeSelectAllHighlight" CornerRadius="4" Margin="1"
                        Background="Transparent" BorderBrush="Transparent" BorderThickness="1.5"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                    <!-- 全选图标：四角框（表示全页面）+ 对勾 -->
                    <Grid Width="14" Height="14">
                        <Path Data="M2,2 H5 M2,2 V5 M12,2 H15 M15,2 V5 M2,12 V15 M2,15 H5 M15,12 V15 M12,15 H15"
                              Stroke="{DynamicResource FloatBarForeground}" StrokeThickness="{StaticResource IconStroke}"/>
                        <Path Data="M4,7.5 L6.5,10 L10,5.5" Stroke="{DynamicResource HighlightBrush}"
                              StrokeThickness="{StaticResource IconStroke}" Fill="Transparent"/>
                    </Grid>
                    <TextBlock Text="全选" FontSize="11" Foreground="{DynamicResource FloatBarForeground}"
                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
