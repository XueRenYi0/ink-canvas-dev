                        <Border Width="36" MouseUp="GridPPTControlNext_MouseUp" Height="36" CornerRadius="5" Background="{DynamicResource FloatBarBackground}" BorderThickness="1" BorderBrush="{DynamicResource FloatBarBorderBrush}">
                            <Grid Margin="6">
                                <Image Source="{DynamicResource ResourceKey=SeewoImageSource.HorizontalNextSlideNormal}"/>
                            </Grid>
                        </Border>
                    </ui:SimpleStackPanel>
                </Viewbox>
            </Grid>
        </Grid>

        <Viewbox Name="ViewboxFloatingBar" Margin="100,10,-2000,-200" 
                 HorizontalAlignment="Left" Height="50" VerticalAlignment="Top">
            <Viewbox.LayoutTransform>
                <ScaleTransform x:Name="ViewboxFloatingBarScaleTransform" ScaleX="1" ScaleY="1"/>
            </Viewbox.LayoutTransform>
            <ui:SimpleStackPanel Orientation="Horizontal">
                <Border Width="36" Height="36" CornerRadius="5" Background="{DynamicResource FloatBarBackground}" BorderThickness="1" BorderBrush="{DynamicResource FloatBarBorderBrush}" MouseDown="SymbolIconEmoji_MouseDown" MouseUp="SymbolIconEmoji_MouseUp" ToolTip="单击展开/收起工具条&#10;按住拖动改变位置&#10;右键打开菜单">
                    <ui:SimpleStackPanel Margin="0,5,0,5" Spacing="10" Orientation="Horizontal"
                                         HorizontalAlignment="Center">
                        <ui:SymbolIcon Name="SymbolIconEmoji" Symbol="Emoji2" Foreground="{DynamicResource FloatBarForeground}"/>
                    </ui:SimpleStackPanel>
                    <Border.ContextMenu>
                        <!--右键快捷菜单：全部复用现有 handler（签名兼容 RoutedEventArgs）-->
                        <ContextMenu>
                            <MenuItem Header="设置" Click="SymbolIconSettings_Click"/>
                            <MenuItem Header="快捷键">
                                <MenuItem Header="查看快捷键" Click="MenuItemShowShortcuts_Click"/>
                                <MenuItem Header="恢复默认快捷键" Click="MenuItemResetShortcuts_Click"/>
                            </MenuItem>
                            <MenuItem Header="重启画板" Click="BtnRestart_Click"/>
                            <Separator/>
                            <MenuItem Header="退出" Click="BtnExit_Click"/>
                        </ContextMenu>
                    </Border.ContextMenu>
                </Border>
                <Border Margin="5,0,0,0" Visibility="Visible" Opacity="0" Height="36" Name="BorderFloatingBarMainControls" Background="{DynamicResource FloatBarBackground}" CornerRadius="5" BorderThickness="1" BorderBrush="{DynamicResource FloatBarBorderBrush}">
                    <Border.RenderTransform>
                        <!--初始 ScaleX=0：启动默认收起为单笑脸图标，与 borderFloatingBarMainControlsVisibility=false 对应-->
                        <ScaleTransform ScaleX="0"/>
                    </Border.RenderTransform>
                    <ui:SimpleStackPanel Name="StackPanelFloatingBar" Spacing="10" Orientation="Horizontal">
                        <ui:SimpleStackPanel Name="StackPanelCanvacMain" Margin="10,5,0,5" Spacing="10" Orientation="{Binding ElementName=StackPanelFloatingBar, Path=Orientation}">
                            <Grid Height="24" Width="0">
                            </Grid>
                            <local:ClickSensitiveGrid Click="SymbolIconCursor_Click" Margin="-10,0,0,0" ToolTip="鼠标模式（隐藏画板，点击穿透）">
                                <ui:SymbolIcon Symbol="Edit" Foreground="{DynamicResource FloatBarForeground}"/>
                            </local:ClickSensitiveGrid>
                            <ui:SymbolIcon Symbol="Setting" Foreground="{DynamicResource FloatBarForeground}" MouseUp="SymbolIconSettings_Click" ToolTip="设置"/>
                            <ui:SymbolIcon Symbol="Refresh" FontSize="16" Foreground="{DynamicResource FloatBarForeground}" MouseUp="BtnRestart_Click" ToolTip="重启画板（自动保存并恢复墨迹）"/>
                            <!-- 退出：圆圈+叉（经典关闭语义）。圆直径17（占位24高的~71%），与
                                 重启 Refresh 字形视觉平衡；粗细复用 IconStroke 与全栏 Path 图标统一。 -->
                            <Grid Height="24" Width="20" Background="Transparent" MouseUp="BtnExit_Click" ToolTip="退出">
                                <Path Data="M10,3 A8.5,8.5 0 1 0 10,20 A8.5,8.5 0 1 0 10,3 Z M7,8 L13,15 M13,8 L7,15"
                                      Stroke="{DynamicResource FloatBarForeground}" StrokeThickness="{StaticResource IconStroke}"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Grid>
                        </ui:SimpleStackPanel>
                        <ui:SimpleStackPanel Name="StackPanelCanvasControls" Visibility="Visible" Margin="10,5,0,5" Spacing="10" Orientation="{Binding ElementName=StackPanelFloatingBar, Path=Orientation}">
                            <local:ClickSensitiveGrid Click="SymbolIconCursor_Click" ToolTip="鼠标模式（隐藏画板，点击穿透）">
                                <ui:SymbolIcon Symbol="TouchPointer" Foreground="{DynamicResource FloatBarForeground}"/>
                            </local:ClickSensitiveGrid>
                            <ui:SimpleStackPanel Orientation="{Binding ElementName=StackPanelFloatingBar, Path=Orientation}" Spacing="8" Margin="0,1">
                                <Border Name="BorderPenColorBlack" Background="{Binding ElementName=BtnColorBlack, Path=Background}" MouseUp="BorderPenColorBlack_MouseUp" CornerRadius="100"
                                    Width="{Binding ElementName=BorderPenColorBlack, Path=ActualHeight}" ToolTip="画笔颜色：黑色">
                                    <Viewbox Opacity="{Binding ElementName=ViewboxBtnColorBlackContent, Path=Opacity}" Margin="6">
                                        <ui:SymbolIcon Symbol="Accept" Foreground="White"/>
                                    </Viewbox>
                                </Border>
                                <Border Name="BorderPenColorRed" Background="{Binding ElementName=BtnColorRed, Path=Background}" MouseUp="BorderPenColorRed_MouseUp" CornerRadius="100"
                                    Width="{Binding ElementName=BorderPenColorRed, Path=ActualHeight}" ToolTip="画笔颜色：红色">
                                    <Viewbox Opacity="{Binding ElementName=ViewboxBtnColorRedContent, Path=Opacity}" Margin="6">
                                        <ui:SymbolIcon Symbol="Accept" Foreground="White"/>
                                    </Viewbox>
                                </Border>
                                <Border Name="BorderPenColorGreen" Background="{Binding ElementName=BtnColorGreen, Path=Background}" MouseUp="BorderPenColorGreen_MouseUp" CornerRadius="100"
                                    Width="{Binding ElementName=BorderPenColorGreen, Path=ActualHeight}" ToolTip="画笔颜色：绿色">
                                    <Viewbox Opacity="{Binding ElementName=ViewboxBtnColorGreenContent, Path=Opacity}" Margin="6">
                                        <ui:SymbolIcon Symbol="Accept" Foreground="White"/>
                                    </Viewbox>
                                </Border>
                                <Border Name="BorderPenColorBlue" Background="{Binding ElementName=BtnColorBlue, Path=Background}" MouseUp="BorderPenColorBlue_MouseUp" CornerRadius="100"
                                    Width="{Binding ElementName=BorderPenColorBlue, Path=ActualHeight}" ToolTip="画笔颜色：蓝色">
                                    <Viewbox Opacity="{Binding ElementName=ViewboxBtnColorBlueContent, Path=Opacity}" Margin="6">
                                        <ui:SymbolIcon Symbol="Accept" Foreground="White"/>
                                    </Viewbox>
                                </Border>
                                <Border Name="BorderPenColorYellow" Background="{Binding ElementName=BtnColorYellow, Path=Background}" MouseUp="BorderPenColorYellow_MouseUp" CornerRadius="100"
                                    Width="{Binding ElementName=BorderPenColorYellow, Path=ActualHeight}" ToolTip="画笔颜色：黄色">
                                    <Viewbox Opacity="{Binding ElementName=ViewboxBtnColorYellowContent, Path=Opacity}" Margin="6">
                                        <ui:SymbolIcon Symbol="Accept" Foreground="White"/>
                                    </Viewbox>
                                </Border>
                                <Border Name="BorderPenColorWhite" Background="White" CornerRadius="100" MouseUp="BorderPenColorWhite_MouseUp"
                                    Width="{Binding ElementName=BorderPenColorYellow, Path=ActualHeight}" ToolTip="画笔颜色：白色">
                                    <Viewbox Name="ViewboxBtnColorWhiteContent" Opacity="0" Margin="6">
                                        <ui:SymbolIcon Symbol="Accept" Foreground="Black"/>
                                    </Viewbox>
                                </Border>
                            </ui:SimpleStackPanel>
                            <Grid x:Name="EraserContainer" Width="21" Height="24" Margin="0,1.5,-2,0" MouseDown="Border_MouseDown" MouseUp="ImageEraser_MouseUp" Visibility="{Binding ElementName=BtnErase, Path=Visibility}" ToolTip="橡皮擦（点击切换：面积擦 / 笔画擦）">
                                <Image Name="ImageEraser" Margin="0,-4,-1,-2" Source="{DynamicResource ImageSource.RubberNormal}" RenderTransformOrigin="0.5,0.5"/>
                                <!-- 选中态图标：形状与 ImageEraser 保持一致，颜色改为蓝/橙；通过 UpdateEraserIcon 同步切换 Source -->
                                <Image Name="ImageEraserMask" Visibility="{Binding Visibility, ElementName=ImageEraser, Converter={StaticResource VisibilityConverter}}" Margin="0,-4,-1,-2" RenderTransformOrigin="0.5,0.5"
                                       Source="{DynamicResource ImageSource.RubberSelectedPoint}"/>
                            </Grid>
                            <Grid Margin="0,0,0,0" Width="20" Background="Transparent" ToolTip="清屏（点击后需再点确认）">
                                <ui:SymbolIcon Name="SymbolIconDelete" Symbol="Delete" Foreground="{DynamicResource FloatBarForeground}"
                                               MouseDown="Border_MouseDown" MouseUp="SymbolIconDelete_MouseUp"/>
                                <Border x:Name="BorderClearInDelete" Visibility="Collapsed" Background="White" BorderBrush="{DynamicResource FloatBarBorderBrush}" BorderThickness="1"
                                    CornerRadius="5" Margin="-40,-60,-40,35">
                                    <Button Content="点击清屏" ui:ThemeManager.RequestedTheme="Light"
                                        FontFamily="Microsoft YaHei UI"
                                        Width="80" HorizontalAlignment="Center"
                                        Click="BtnClear_Click"/>
                                </Border>
                            </Grid>
                            <!-- 选择墨迹：虚线框 + 箭头光标（示意"拖框选择"），替换原 SelectAll 纯虚线框；粗细用 IconStroke 资源，与原生 SymbolIcon 一致 -->
                            <!-- Background=Transparent 使整块区域可命中测试：Grid 默认背景为 null，悬停在虚线框空白处会丢失 ToolTip 和点击 -->
                            <Grid Name="GridSelectTool" Height="24" Width="20" Background="Transparent" MouseUp="SymbolIconSelect_MouseUp" ToolTip="选择墨迹（框选后拖动/缩放/旋转）">
                                <Path Name="PathSelectBox" Data="M3,4 H16 V15 H3 Z"
                                      Stroke="{DynamicResource FloatBarForeground}" StrokeThickness="{StaticResource IconStroke}"
                                      StrokeDashArray="2.8,2.2"/>
                                <Path Name="PathSelectCursor" Data="M12.4,8.3 L12.4,19.8 L15,17 L16.6,20.4 L18,19.8 L16.7,16.5 L20.3,16.5 Z"
                                      Fill="{DynamicResource FloatBarForeground}"/>
                            </Grid>
                            <Grid Margin="3,5,0,5">
                                <Image Name="ImageDrawShape" MouseUp="ImageDrawShape_MouseUp" MouseDown="Border_MouseDown" Margin="-2.5" Source="{DynamicResource DrawShapeImageSource.DrawShapeIcon}" ToolTip="图形绘制"/>
                                <Border x:Name="BorderDrawShape" Visibility="Visible" Background="{DynamicResource FloatBarBackground}" BorderBrush="{DynamicResource FloatBarBorderBrush}" BorderThickness="1"
                                    CornerRadius="8" Margin="-100,-315,-100,30" Width="420">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- ===== 分区一：标题栏（整行都是拖动手柄，双击复位；面板已解挂为自由小窗口） ===== -->
                                        <Grid Grid.Row="0" Background="Transparent" Cursor="SizeAll"
                                              MouseLeftButtonDown="ShapePanelTitle_MouseDown" MouseMove="ShapePanelTitle_MouseMove"
                                              MouseLeftButtonUp="ShapePanelTitle_MouseUp"
                                              ToolTip="按住拖动面板 · 双击复位位置和大小">
                                            <TextBlock FontSize="14" Foreground="{DynamicResource FloatBarForeground}" Margin="10,6,0,6" VerticalAlignment="Center">
                                                <Run Text="图形"/>
                                            </TextBlock>
                                            <ui:ToggleSwitch Name="ToggleSwitchDrawShapeBorderAutoHide" Visibility="Collapsed" Foreground="{DynamicResource FloatBarForeground}" FontFamily="Microsoft YaHei UI" Width="70" OnContent="开" OffContent="关" IsOn="True"/>
                                            <!-- 图钉：Hand 光标 = 可点（区别于标题栏的 SizeAll 可拖光标，光标可供性） -->
                                            <ui:SymbolIcon Symbol="Pin" Margin="0,0,8,0" Cursor="Hand" MouseDown="SymbolIconPinDrawShape_MouseDown" MouseUp="SymbolIconPinBorderDrawShape_MouseUp"
                                                           Foreground="{DynamicResource FloatBarForeground}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>

                                        <!-- ===== 分区二：图形图标（WrapPanel 流式排列 + 48×48 正方格 + 6px 间距 =====
                                             正方格保证纵横比一致（圆不压扁）；Uniform 拉伸让各图标视觉重量对齐；
                                             高度可拖：多出的高度喂给本 ScrollViewer，可视行数变多 -->
                                        <ScrollViewer Grid.Row="1" Name="ShapeIconScroll" MaxHeight="216" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="6,0,6,0">
                                            <WrapPanel>
                                                <Border Name="BorderShapeIcon_1" Width="48" Height="48" Margin="3" CornerRadius="4" Background="Transparent" ToolTip="直线（拖拽绘制，两点定线）">
                                                    <Image Name="ImageDrawLine" Stretch="Uniform" MouseDown="Image_MouseDown" MouseUp="BtnDrawLine_Click" Source="{DynamicResource DrawShapeImageSource.Line}"/>
                                                </Border>
                                                <Border Name="BorderShapeIcon_8" Width="48" Height="48" Margin="3" CornerRadius="4" Background="Transparent" ToolTip="虚线（拖拽绘制，两点定线）">
                                                    <Image Name="ImageDrawDashedLine" Stretch="Uniform" MouseDown="Image_MouseDown" MouseUp="BtnDrawDashedLine_Click" Source="{DynamicResource DrawShapeImageSource.DashedLine}"/>
                                                </Border>
                                                <Border Name="BorderShapeIcon_18" Width="48" Height="48" Margin="3" CornerRadius="4" Background="Transparent" ToolTip="点线（拖拽绘制，两点定线）">
                                                    <Image Name="ImageDrawDotLine" Stretch="Uniform" MouseDown="Image_MouseDown" MouseUp="BtnDrawDotLine_Click" Source="{DynamicResource DrawShapeImageSource.DotLine}"/>
                                                </Border>
                                                <Border Name="BorderShapeIcon_2" Width="48" Height="48" Margin="3" CornerRadius="4" Background="Transparent" ToolTip="箭头（拖拽绘制，起点到终点）">
                                                    <Image Name="ImageDrawArrow" Stretch="Uniform" MouseDown="Image_MouseDown" MouseUp="BtnDrawArrow_Click" Source="{DynamicResource DrawShapeImageSource.ArrowLine}"/>
                                                </Border>
                                                <Border Name="BorderShapeIcon_15" Width="48" Height="48" Margin="3" CornerRadius="4" Background="Transparent" ToolTip="平行线（拖拽绘制，两条平行线）">
                                                    <Image Name="ImageDrawParallelLine" Stretch="Uniform" MouseDown="Image_MouseDown" MouseUp="BtnDrawParallelLine_Click" Source="{DynamicResource DrawShapeImageSource.ParallelLine}"/>
                                                </Border>
                                                <Border Name="BorderShapeIcon_11" Width="48" Height="48" Margin="3" CornerRadius="4" Background="Transparent" ToolTip="坐标系1（拖拽绘制，标准十字坐标系）">
                                                    <Image Stretch="Uniform" MouseUp="BtnDrawCoordinate1_Click" Source="{DynamicResource DrawShapeImageSource.Coordinate1}"/>
                                                </Border>
                                                <Border Name="BorderShapeIcon_12" Width="48" Height="48" Margin="3" CornerRadius="4" Background="Transparent" ToolTip="坐标系2（拖拽绘制，带箭头标注）">
                                                    <Image Stretch="Uniform" MouseUp="BtnDrawCoordinate2_Click" Source="{DynamicResource DrawShapeImageSource.Coordinate2}"/>
                                                </Border>
                                                <Border Name="BorderShapeIcon_13" Width="48" Height="48" Margin="3" CornerRadius="4" Background="Transparent" ToolTip="坐标系3（拖拽绘制，带网格样式）">
                                                    <Image Stretch="Uniform" MouseUp="BtnDrawCoordinate3_Click" Source="{DynamicResource DrawShapeImageSource.Coordinate3}"/>
                                                </Border>
                                                <Border Name="BorderShapeIcon_14" Width="48" Height="48" Margin="3" CornerRadius="4" Background="Transparent" ToolTip="坐标系4（拖拽绘制，带刻度样式）">
                                                    <Image Stretch="Uniform" MouseUp="BtnDrawCoordinate4_Click" Source="{DynamicResource DrawShapeImageSource.Coordinate4}"/>
                                                </Border>
                                                <Border Name="BorderShapeIcon_17" Width="48" Height="48" Margin="3" CornerRadius="4" Background="Transparent" ToolTip="坐标系5（拖拽绘制，象限标注样式）">
                                                    <Image Stretch="Uniform" MouseUp="BtnDrawCoordinate5_Click" Source="{DynamicResource DrawShapeImageSource.Coordinate5}"/>
                                                </Border>
                                                <Border Name="BorderShapeIcon_19" Width="48" Height="48" Margin="3" CornerRadius="4" Background="Transparent" ToolTip="中心矩形（从中心拖拽绘制矩形）">
                                                    <Image Stretch="Uniform" MouseUp="BtnDrawRectangleCenter_Click" Source="{DynamicResource DrawShapeImageSource.RectangleCenter}"/>
                                                </Border>
                                                <Border Name="BorderShapeIcon_5" Width="48" Height="48" Margin="3" CornerRadius="4" Background="Transparent" ToolTip="圆（拖拽绘制：按下点为圆心，拖到半径松手）">
                                                    <Image Stretch="Uniform" MouseUp="BtnDrawCircle_Click" Source="{DynamicResource DrawShapeImageSource.Circle}"/>
                                                </Border>
                                                <Border Name="BorderShapeIcon_10" Width="48" Height="48" Margin="3" CornerRadius="4" Background="Transparent" ToolTip="虚线圆（拖拽绘制虚线样式的圆）">
                                                    <Image Stretch="Uniform" MouseUp="BtnDrawDashedCircle_Click" Source="{DynamicResource DrawShapeImageSource.DashedCircle}"/>
                                                </Border>
                                                <Border Name="BorderShapeIcon_16" Width="48" Height="48" Margin="3" CornerRadius="4" Background="Transparent" ToolTip="中心椭圆（拖拽绘制：按下点为中心，带中心点标记）">
                                                    <Image Stretch="Uniform" MouseUp="BtnDrawCenterEllipse_Click" Source="{DynamicResource DrawShapeImageSource.EllipseCenter}"/>
                                                </Border>
                                                <Border Name="BorderShapeIcon_23" Width="48" Height="48" Margin="3" CornerRadius="4" Background="Transparent" ToolTip="中心椭圆带焦点（拖拽绘制，带两个焦点标记）">
                                                    <Image Stretch="Uniform" MouseUp="BtnDrawCenterEllipseWithFocalPoint_Click" Source="{DynamicResource DrawShapeImageSource.EllipseCenterWithFocalPoint}"/>
                                                </Border>
                                                <Border Name="BorderShapeIcon_24" Width="48" Height="48" Margin="3" CornerRadius="4" Background="Transparent" ToolTip="双曲线（两步：第一步画渐近线，第二步画双曲线本体）">
                                                    <Image Stretch="Uniform" MouseUp="BtnDrawHyperbola_Click" Source="{DynamicResource DrawShapeImageSource.Hyperbola}"/>
                                                </Border>
                                                <Border Name="BorderShapeIcon_25" Width="48" Height="48" Margin="3" CornerRadius="4" Background="Transparent" ToolTip="双曲线带焦点（两步：先画渐近线，再画曲线，自动标焦点）">
                                                    <Image Stretch="Uniform" MouseUp="BtnDrawHyperbolaWithFocalPoint_Click" Source="{DynamicResource DrawShapeImageSource.HyperbolaWithFocalPoint}"/>
                                                </Border>
                                                <Border Name="BorderShapeIcon_20" Width="48" Height="48" Margin="3" CornerRadius="4" Background="Transparent" ToolTip="抛物线（拖拽绘制：按下点为顶点，拖出开口方向和宽度）">
                                                    <Image Stretch="Uniform" MouseUp="BtnDrawParabola1_Click" Source="{DynamicResource DrawShapeImageSource.Parabola}"/>
                                                </Border>
                                                <Border Name="BorderShapeIcon_22" Width="48" Height="48" Margin="3" CornerRadius="4" Background="Transparent" ToolTip="抛物线带焦点（拖拽绘制，自动标出焦点）">
                                                    <Image Stretch="Uniform" MouseUp="BtnDrawParabolaWithFocalPoint_Click" Source="{DynamicResource DrawShapeImageSource.ParabolaWithFocalPoint}" RenderTransformOrigin="0.5,0.5">
                                                        <Image.RenderTransform>
                                                            <TransformGroup>
                                                                <ScaleTransform/>
                                                                <SkewTransform/>
                                                                <RotateTransform Angle="90"/>
                                                                <TranslateTransform/>
                                                            </TransformGroup>
                                                        </Image.RenderTransform>
                                                    </Image>
                                                </Border>
                                                <Border Name="BorderShapeIcon_21" Width="48" Height="48" Margin="3" CornerRadius="4" Background="Transparent" ToolTip="抛物线（横向：开口向左或右的抛物线）">
                                                    <Image Stretch="Uniform" MouseUp="BtnDrawParabola2_Click" Source="{DynamicResource DrawShapeImageSource.Parabola}" RenderTransformOrigin="0.5,0.5">
                                                        <Image.RenderTransform>
                                                            <TransformGroup>
                                                                <ScaleTransform/>
                                                                <SkewTransform/>
                                                                <RotateTransform Angle="90"/>
                                                                <TranslateTransform/>
                                                            </TransformGroup>
                                                        </Image.RenderTransform>
                                                    </Image>
                                                </Border>
                                                <Border Name="BorderShapeIcon_26" Width="48" Height="48" Margin="3" CornerRadius="4" Background="Transparent" ToolTip="正弦曲线（拖拽绘制：横向=一个周期，纵向=振幅）">
                                                    <Image Stretch="Uniform" MouseUp="BtnDrawSin_Click" Source="{DynamicResource DrawShapeImageSource.SinCurve}"/>
                                                </Border>
                                                <Border Name="BorderShapeIcon_3" Width="48" Height="48" Margin="3" CornerRadius="4" Background="Transparent" ToolTip="矩形（拖拽绘制，对角线定矩形）">
                                                    <Image Stretch="Uniform" MouseUp="BtnDrawRectangle_Click" Source="{DynamicResource DrawShapeImageSource.Rectangle}"/>
                                                </Border>
                                                <Border Name="BorderShapeIcon_6" Width="48" Height="48" Margin="3" CornerRadius="4" Background="Transparent" ToolTip="圆柱（拖拽绘制：先画侧面，再画上下底面椭圆）">
                                                    <Image Stretch="Uniform" MouseUp="BtnDrawCylinder_Click" Source="{DynamicResource DrawShapeImageSource.Cylinder}"/>
                                                </Border>
                                                <Border Name="BorderShapeIcon_7" Width="48" Height="48" Margin="3" CornerRadius="4" Background="Transparent" ToolTip="圆锥（拖拽绘制，自动生成圆锥体图形）">
                                                    <Image Stretch="Uniform" MouseUp="BtnDrawCone_Click" Source="{DynamicResource DrawShapeImageSource.Cone}"/>
                                                </Border>
                                                <Border Name="BorderShapeIcon_9" Width="48" Height="48" Margin="3" CornerRadius="4" Background="Transparent" ToolTip="长方体（两步：先画正面矩形，再拖出深度）">
                                                    <Image Stretch="Uniform" MouseUp="BtnDrawCuboid_Click" Source="{DynamicResource DrawShapeImageSource.Cuboid}"/>
                                                </Border>
                                                <Viewbox Width="48" Height="48" Margin="3">
                                                    <ui:SimpleStackPanel>
                                                        <Image Height="55" Visibility="{Binding ElementName=GroupBoxMASEZVersion, Path=Visibility}" Source="Resources/logo2.png"/>
                                                        <TextBlock Margin="0,-15,0,0" Visibility="{Binding ElementName=GroupBoxMASEZVersion, Path=Visibility}" Text="二中专版" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{DynamicResource FloatBarForeground}"/>
                                                    </ui:SimpleStackPanel>
                                                </Viewbox>
                                            </WrapPanel>
                                        </ScrollViewer>

                                        <!-- ===== 分区 2.5：函数识别通栏条（图标+文字，弹窗式工具与图标格视觉区隔；面板开启时亮蓝） ===== -->
                                        <Border Grid.Row="2" Name="BorderShapeIcon_27" CornerRadius="4" Background="Transparent" Margin="8,4,8,2" Padding="8,6" Cursor="Hand"
                                                ToolTip="函数识别作图：手写公式，识别后插入函数图像" MouseUp="BtnRecognizeFunction_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <Image Width="22" Height="22" Stretch="Uniform" Source="{DynamicResource DrawShapeImageSource.FunctionRecognize}" VerticalAlignment="Center"/>
                                                <TextBlock Text="函数识别作图" FontSize="13" Foreground="{DynamicResource FloatBarForeground}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                <TextBlock Text="手写 → 图像" FontSize="10" Foreground="{DynamicResource FloatBarForeground}" Opacity="0.55" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- ===== 分区三：图库（WrapPanel 自动换行，超出高度内部滚动；"整理"= 触摸删除入口） ===== -->
                                        <ui:SimpleStackPanel Grid.Row="3" Name="StackPanelCustomShapesRow" Orientation="Vertical" Margin="6,0,6,2">
                                            <Grid Margin="8,2,4,2">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="图库" FontSize="11" Foreground="{DynamicResource FloatBarForeground}" VerticalAlignment="Center"/>
                                                    <TextBlock Name="TextBlockLibraryCount" Text="" FontSize="10" Foreground="{DynamicResource FloatBarForeground}" Opacity="0.6" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                                </StackPanel>
                                                <Border Name="BorderLibraryEdit" CornerRadius="4" Background="Transparent" Padding="8,3" HorizontalAlignment="Right" Cursor="Hand"
                                                        ToolTip="整理图库：显示删除按钮（触摸屏适用）"
                                                        MouseDown="Border_MouseDown" MouseUp="BorderLibraryEdit_MouseUp">
                                                    <TextBlock Name="TextBlockLibraryEdit" Text="整理" FontSize="11" Foreground="{DynamicResource FloatBarForeground}"/>
                                                </Border>
                                            </Grid>
                                            <ScrollViewer Name="LibraryScroll" MaxHeight="88" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="8,0,8,0">
                                                <WrapPanel Name="StackPanelCustomShapes"/>
                                            </ScrollViewer>
                                        </ui:SimpleStackPanel>

