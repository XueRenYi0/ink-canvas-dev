        <!--笔记上下滚动控制：白板/黑板与屏幕注释模式可见（MW_Scroll.cs 定时器统一控制可见性），支持滚轮与按钮-->
        <!--优化组合：1)左右对称双胶囊（两侧均可触达，控制同一视图）2)滑块可拖动直接跳转（胶囊176px/轨道88px/行程66px）
            3)悬停显形（平时半透明不碍眼，悬停/拖动时1.0，见 MW_Scroll.cs GridNoteScroll*_MouseEnter/Leave）-->
        <Grid x:Name="GridNoteScrollControls" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"
              Visibility="Collapsed"
              MouseEnter="GridNoteScrollControls_MouseEnter" MouseLeave="GridNoteScrollControls_MouseLeave">
            <Border x:Name="BorderScrollCapsule" Width="34" Height="220" CornerRadius="17"
                    Background="{DynamicResource FloatBarBackground}" BorderThickness="1" BorderBrush="{DynamicResource FloatBarBorderBrush}"
                    RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="ScrollCapsuleScale" ScaleX="1" ScaleY="1"/>
                </Border.RenderTransform>
                <Border.Triggers>
                    <!--悬停反馈：轻微放大，暗示可交互-->
                    <EventTrigger RoutedEvent="MouseEnter">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="ScrollCapsuleScale" Storyboard.TargetProperty="ScaleX" To="1.1" Duration="0:0:0.12"/>
                                <DoubleAnimation Storyboard.TargetName="ScrollCapsuleScale" Storyboard.TargetProperty="ScaleY" To="1.1" Duration="0:0:0.12"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                    <EventTrigger RoutedEvent="MouseLeave">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="ScrollCapsuleScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.15"/>
                                <DoubleAnimation Storyboard.TargetName="ScrollCapsuleScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.15"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="38"/>
                        <RowDefinition Height="144"/>
                        <RowDefinition Height="38"/>
                    </Grid.RowDefinitions>
                    <!--上：滚回历史墨迹（滚到顶时图标淡化=禁用态，MW_Scroll.cs 控制 PathScrollUp.Opacity）-->
                    <Border Grid.Row="0" Background="Transparent" Cursor="Hand"
                            MouseDown="Border_MouseDown" MouseUp="BtnScrollUp_MouseUp">
                        <Path x:Name="PathScrollUp" Data="M7,13.5 L15,5.5 L23,13.5" Stroke="{DynamicResource FloatBarForeground}" StrokeThickness="2.5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="22" Height="16" Stretch="Uniform"/>
                    </Border>
                    <!--中：位置指示条——可拖动滑块（按下即跳转到对应位置，拖动中实时滚动）。
                        轨道 3px、滑块 6×14 竖胶囊；行程 = 轨道144 - 滑块14 - 上下边距8 = 122px（MW_Scroll.cs ScrollThumbTravel）-->
                    <Grid Grid.Row="1" x:Name="GridScrollTrackR">
                        <Border Width="3" CornerRadius="1.5" Background="{DynamicResource FloatBarForeground}" Opacity="0.25"
                                VerticalAlignment="Stretch" HorizontalAlignment="Center" Margin="0,4,0,4"/>
                        <Border x:Name="BorderScrollThumb" Width="6" Height="14" CornerRadius="3" HorizontalAlignment="Center"
                                Background="{DynamicResource FloatBarForeground}" Opacity="0.65" VerticalAlignment="Top" Margin="0,4,0,0"
                                Cursor="Hand"
                                MouseDown="BorderScrollThumb_MouseDown" MouseMove="BorderScrollThumb_MouseMove" MouseUp="BorderScrollThumb_MouseUp"/>
                    </Grid>
                    <!--下：滚出空白继续书写-->
                    <Border Grid.Row="2" Background="Transparent" Cursor="Hand"
                            MouseDown="Border_MouseDown" MouseUp="BtnScrollDown_MouseUp">
                        <Path Data="M7,5.5 L15,13.5 L23,5.5" Stroke="{DynamicResource FloatBarForeground}" StrokeThickness="2.5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="22" Height="16" Stretch="Uniform"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>
        <!--左侧镜像胶囊：与右侧控制同一视图（共享 _noteScrollOffsetY，MW_Scroll.cs 同步两侧滑块/禁用态）。
            站屏幕左侧的人无需横跨大屏去够右边缘；多人书写时任一侧均可就近滚动-->
        <Grid x:Name="GridNoteScrollControlsLeft" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0,0,0"
              Visibility="Collapsed"
              MouseEnter="GridNoteScrollControlsLeft_MouseEnter" MouseLeave="GridNoteScrollControlsLeft_MouseLeave">
            <Border x:Name="BorderScrollCapsuleL" Width="34" Height="220" CornerRadius="17"
                    Background="{DynamicResource FloatBarBackground}" BorderThickness="1" BorderBrush="{DynamicResource FloatBarBorderBrush}"
                    RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="ScrollCapsuleScaleL" ScaleX="1" ScaleY="1"/>
                </Border.RenderTransform>
                <Border.Triggers>
                    <EventTrigger RoutedEvent="MouseEnter">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="ScrollCapsuleScaleL" Storyboard.TargetProperty="ScaleX" To="1.1" Duration="0:0:0.12"/>
                                <DoubleAnimation Storyboard.TargetName="ScrollCapsuleScaleL" Storyboard.TargetProperty="ScaleY" To="1.1" Duration="0:0:0.12"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                    <EventTrigger RoutedEvent="MouseLeave">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="ScrollCapsuleScaleL" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.15"/>
                                <DoubleAnimation Storyboard.TargetName="ScrollCapsuleScaleL" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.15"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="38"/>
                        <RowDefinition Height="144"/>
                        <RowDefinition Height="38"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="Transparent" Cursor="Hand"
                            MouseDown="Border_MouseDown" MouseUp="BtnScrollUp_MouseUp">
                        <Path x:Name="PathScrollUpL" Data="M7,13.5 L15,5.5 L23,13.5" Stroke="{DynamicResource FloatBarForeground}" StrokeThickness="2.5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="22" Height="16" Stretch="Uniform"/>
                    </Border>
                    <Grid Grid.Row="1" x:Name="GridScrollTrackL">
                        <Border Width="3" CornerRadius="1.5" Background="{DynamicResource FloatBarForeground}" Opacity="0.25"
                                VerticalAlignment="Stretch" HorizontalAlignment="Center" Margin="0,4,0,4"/>
                        <Border x:Name="BorderScrollThumbL" Width="6" Height="14" CornerRadius="3" HorizontalAlignment="Center"
                                Background="{DynamicResource FloatBarForeground}" Opacity="0.65" VerticalAlignment="Top" Margin="0,4,0,0"
                                Cursor="Hand"
                                MouseDown="BorderScrollThumb_MouseDown" MouseMove="BorderScrollThumb_MouseMove" MouseUp="BorderScrollThumb_MouseUp"/>
                    </Grid>
                    <Border Grid.Row="2" Background="Transparent" Cursor="Hand"
                            MouseDown="Border_MouseDown" MouseUp="BtnScrollDown_MouseUp">
                        <Path Data="M7,5.5 L15,13.5 L23,5.5" Stroke="{DynamicResource FloatBarForeground}" StrokeThickness="2.5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="22" Height="16" Stretch="Uniform"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
