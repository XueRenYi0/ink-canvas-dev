<Window x:Class="Ink_Canvas.ScreenshotMaskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="截图遮罩" Width="800" Height="600"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        Cursor="Cross"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewStylusDown="Window_PreviewStylusDown"
        PreviewStylusMove="Window_PreviewStylusMove"
        PreviewStylusUp="Window_PreviewStylusUp"
        PreviewMouseLeftButtonDown="Window_PreviewMouseLeftButtonDown"
        PreviewMouseMove="Window_PreviewMouseMove"
        PreviewMouseLeftButtonUp="Window_PreviewMouseLeftButtonUp"
        PreviewMouseRightButtonUp="Window_PreviewMouseRightButtonUp"
        Deactivated="Window_Deactivated">
    <!-- 截图遮罩窗口：铺满主屏的半透明黑罩，用户在上面拖框选区。
         视觉结构：暗罩(Path 挖洞) + 选区蓝框 + 尺寸角标 + 顶部操作提示。
         所有绘制（选区框/挖洞）都在代码后台动态更新，XAML 只放空壳。 -->
    <Grid>
        <!-- 暗罩：初始只有"全屏矩形"一个图形（整屏全暗）；
             拖选后代码会把它改成"全屏矩形 + 选区矩形"的 EvenOdd 组合，
             选区处相当于被"挖洞"变亮，用户能看清要截什么 -->
        <Path x:Name="MaskPath" Fill="#66000000"/>

        <!-- 选区可视化容器：蓝框 + 尺寸角标由代码用 Canvas 坐标摆放 -->
        <Canvas IsHitTestVisible="False">
            <!-- 选区边框：1.5px 蓝色描边（与软件选中高亮同色系） -->
            <Border x:Name="SelectionBorder" BorderBrush="#0088FF" BorderThickness="1.5"
                    Visibility="Collapsed"/>
            <!-- 尺寸角标：选区右下角的小黑底白字标签，实时显示 W × H -->
            <Border x:Name="SizeBadge" Visibility="Collapsed" CornerRadius="3"
                    Background="#CC000000" Padding="6,2">
                <TextBlock x:Name="SizeText" Foreground="White" FontSize="12"
                           FontFamily="Microsoft YaHei UI"/>
            </Border>
        </Canvas>

        <!-- 顶部操作提示：开始拖选后隐藏 -->
        <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,60,0,0"
                Background="#CC000000" CornerRadius="4" Padding="12,6"
                IsHitTestVisible="False">
            <TextBlock x:Name="HintText" Foreground="White" FontSize="14"
                       FontFamily="Microsoft YaHei UI"
                       Text="拖动框选截图区域    （Esc / 右键 取消）"/>
        </Border>
    </Grid>
</Window>
