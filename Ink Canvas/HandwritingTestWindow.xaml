<Window x:Class="Ink_Canvas.HandwritingTestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        Topmost="True"
        mc:Ignorable="d" WindowStartupLocation="CenterScreen"
        Title="手写公式识别测试（诊断版）" Height="760" Width="920">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <!--0 说明文字（固定高）-->
            <RowDefinition Height="Auto"/>
            <!--1 画布区（占满剩余空间——图像展示的主角，绝不允许被挤小）-->
            <RowDefinition Height="*"/>
            <!--2 按钮行（固定高）-->
            <RowDefinition Height="Auto"/>
            <!--3 结果区（固定高，内部滚动）-->
            <RowDefinition Height="Auto" MaxHeight="90"/>
            <!--4 诊断区（限高 + 内部滚动，防止越积越多挤压画布）-->
            <RowDefinition Height="Auto" MaxHeight="130"/>
        </Grid.RowDefinitions>

        <!--说明文字：告诉测试者怎么用-->
        <TextBlock TextWrapping="Wrap" Foreground="#666" Margin="0,0,0,8"
                   Text="点【数学输入面板】→ 在弹出窗口手写公式 → 点插入。手写内容会被识别并画成函数图像。"/>

        <!--图像展示区：本窗口的主角，占据主要空间-->
        <Border Grid.Row="1" BorderBrush="#0066BF" BorderThickness="1" CornerRadius="6" Background="White">
            <InkCanvas Name="TestInkCanvas" Background="White"/>
        </Border>

        <!--按钮行：识别 / 清除 / 橡皮 / 数学面板-->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="清除笔迹" Width="110" Height="36" Click="BtnClear_Click" FontSize="15"/>
            <Button Content="橡皮模式" Width="110" Height="36" Margin="12,0,0,0" Click="BtnToggleEraser_Click" FontSize="15"/>
            <!--系统自带的数学输入面板（micaut.dll）：专门识别手写公式，返回 MathML-->
            <Button Content="数学输入面板" Width="130" Height="36" Margin="12,0,0,0" Click="BtnMathInput_Click" FontSize="15" Background="#E8F4FF"/>
        </StackPanel>

        <!--识别结果区：限高滚动，内容再多也不会推挤画布-->
        <Border Grid.Row="3" Margin="0,12,0,0" BorderBrush="#DDD" BorderThickness="1" CornerRadius="6" Padding="10"
                Background="#FAFAFA">
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="60">
                <StackPanel>
                    <TextBlock Text="识别结果：" FontWeight="Bold"/>
                    <TextBlock Name="TextBlockBestResult" Text="（尚未识别）" FontSize="20" Foreground="#0066BF" TextWrapping="Wrap"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!--诊断信息区：限高滚动，MathML 原文再长也只在框内滚-->
        <Border Grid.Row="4" Margin="0,12,0,0" BorderBrush="#F0AD4E" BorderThickness="1" CornerRadius="6" Padding="10"
                Background="#FFFBEA">
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="100">
                <StackPanel>
                    <TextBlock Text="诊断信息（MathML 原文 / 异常详情）：" FontWeight="Bold" Foreground="#8A6D3B"/>
                    <TextBlock Name="TextBlockDiagnostics" Text="检测中..." Foreground="#8A6D3B" TextWrapping="Wrap"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
