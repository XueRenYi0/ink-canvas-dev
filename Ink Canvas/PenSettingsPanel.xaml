<UserControl x:Class="Ink_Canvas.PenSettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
             FontFamily="Microsoft YaHei UI">
    <!-- ============================================================
         笔设置面板：点笔图标弹出，点面板外任意处消失。
         分区（自上而下）：笔种类（画笔/荧光笔/激光笔）→ 粗细（五档）→ 颜色（9 预设+1 自定义，两行五列）→ 笔锋。
         - 选中态统一：淡蓝底 + 蓝边（HighlightBrush / PenPanelSoftHighlight）
         - 面板圆角 5、控件圆角 4、图标描边 IconStroke 1.22（InkSpec.xaml 规范）
         - 前 5 色由 MainWindow 注入（SetColorBrushes，支持 Colors\*.ini 自定义配色），
           白/橙/紫/青为固定色，第 10 格为自定义色（取色板选色，SetCustomColorBrush）
         - 粗细/颜色/笔锋面板内点选不关面板；荧光笔与画笔的粗细档位各自独立记忆
         - 笔锋仅画笔有效：荧光笔/激光笔时整区灰显禁用（SetTaperSectionEnabled）
         - 交互事件通过 code-behind 抛给 MainWindow 订阅（PenTypeSelected 等）
         ============================================================ -->
    <UserControl.Resources>
        <!-- 选中态淡蓝底（约 15% 不透明度，与浮动条笔图标高亮同色系） -->
        <SolidColorBrush x:Key="PenPanelSoftHighlight" Color="#260088FF"/>
    </UserControl.Resources>

    <Border CornerRadius="5" Background="{DynamicResource FloatBarBackground}"
            BorderBrush="{DynamicResource FloatBarBorderBrush}" BorderThickness="1"
            HorizontalAlignment="Left" VerticalAlignment="Top">
        <StackPanel Margin="10,8,10,8">

            <!-- ===== 分区一：笔种类（画笔 / 荧光笔 / 激光笔）===== -->
            <UniformGrid Rows="1" Columns="3">
                <Grid x:Name="BorderPenTypePen" Width="56" Height="46" Background="Transparent"
                      MouseUp="PenTypeButton_MouseUp" ToolTip="画笔（快捷键 F2）&#10;普通墨迹笔">
                    <Border x:Name="PenTypePenHighlight" CornerRadius="4" Margin="1"
                            Background="Transparent" BorderBrush="Transparent" BorderThickness="1.5"/>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <!-- 画笔图标：斜置笔身轮廓（细线风格，与全栏自绘图标统一） -->
                        <Path Data="M4.5,19.5 L5.8,14.9 L15.8,4.9 A2.2,2.2 0 0 1 18.9,8 L8.9,18 Z"
                              Stroke="{DynamicResource FloatBarForeground}" StrokeThickness="{StaticResource IconStroke}"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Width="14" Height="14" Stretch="Uniform"/>
                        <TextBlock Text="画笔" FontSize="10" Foreground="{DynamicResource FloatBarForeground}"
                                   HorizontalAlignment="Center" Margin="0,3,0,0"/>
                    </StackPanel>
                </Grid>
                <Grid x:Name="BorderPenTypeHighlighter" Width="56" Height="46" Background="Transparent"
                      MouseUp="PenTypeButton_MouseUp" ToolTip="荧光笔&#10;宽扁半透明笔迹，覆盖在板书上高亮标注">
                    <Border x:Name="PenTypeHighlighterHighlight" CornerRadius="4" Margin="1"
                            Background="Transparent" BorderBrush="Transparent" BorderThickness="1.5"/>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <!-- 荧光笔图标：宽斜切笔头 -->
                        <Path Data="M4,20 L6.5,14 L14,6.5 L17.5,10 L10,17.5 Z"
                              Stroke="{DynamicResource FloatBarForeground}" StrokeThickness="{StaticResource IconStroke}"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Width="14" Height="14" Stretch="Uniform"/>
                        <TextBlock Text="荧光笔" FontSize="10" Foreground="{DynamicResource FloatBarForeground}"
                                   HorizontalAlignment="Center" Margin="0,3,0,0"/>
                    </StackPanel>
                </Grid>
                <Grid x:Name="BorderPenTypeLaser" Width="56" Height="46" Background="Transparent"
                      MouseUp="PenTypeButton_MouseUp" ToolTip="激光笔&#10;临时指示笔迹，约 1 秒后自动淡出消失（不进撤销栈）">
                    <Border x:Name="PenTypeLaserHighlight" CornerRadius="4" Margin="1"
                            Background="Transparent" BorderBrush="Transparent" BorderThickness="1.5"/>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <!-- 激光笔图标：笔身 + 射线 + 光点 -->
                        <Grid Width="14" Height="14">
                            <Path Data="M4.5,13 L7,10.5" Stroke="{DynamicResource FloatBarForeground}"
                                  StrokeThickness="{StaticResource IconStrokeBold}" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            <Path Data="M7.5,10 L12,5.5" Stroke="{DynamicResource FloatBarForeground}"
                                  StrokeThickness="{StaticResource IconStroke}" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            <Ellipse Width="3" Height="3" Fill="{DynamicResource FloatBarForeground}"
                                     HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0.5,0.5,0"/>
                            <Path Data="M13.5,1.5 L13,0.3 M14.5,2.5 L15.7,2" Stroke="{DynamicResource FloatBarForeground}"
                                  StrokeThickness="0.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Grid>
                        <TextBlock Text="激光笔" FontSize="10" Foreground="{DynamicResource FloatBarForeground}"
                                   HorizontalAlignment="Center" Margin="0,3,0,0"/>
                    </StackPanel>
                </Grid>
            </UniformGrid>

            <!-- 分隔线 -->
            <Border Height="1" Background="{DynamicResource FloatBarForeground}" Opacity="0.2" Margin="2,6,2,6"/>

            <!-- ===== 分区二：粗细（五档，与笔种类联动换肤）=====
                 画笔/激光笔档位（圆点）：1.5 / 2.5 / 4 / 6 / 9
                 荧光笔档位（横条=高亮带宽）：6 / 10 / 14 / 20 / 26
                 两套档位各自独立记忆（PowerPoint/OneNote/Epic Pen 同款设计）；
                 切换笔种类时 SetThicknessStyle 换显圆点/横条，一眼区分两套档位 -->
            <UniformGrid Rows="1" Columns="5">
                <Grid x:Name="BorderThickness1" Width="34" Height="32" Background="Transparent"
                      MouseUp="ThicknessButton_MouseUp" ToolTip="笔粗细：1.5（最细）">
                    <Border x:Name="Thickness1Highlight" CornerRadius="4" Margin="1"
                            Background="Transparent" BorderBrush="Transparent" BorderThickness="1.5"/>
                    <!-- 画笔/激光笔：圆点（直径对应笔迹宽） -->
                    <Ellipse x:Name="ThicknessDot1" Width="4" Height="4" Fill="{DynamicResource FloatBarForeground}"/>
                    <!-- 荧光笔：横条（高度对应高亮带宽度；语义上荧光笔就是"宽笔带"） -->
                    <Border x:Name="ThicknessBar1" Visibility="Collapsed" Width="16" Height="4"
                            CornerRadius="2" Background="{DynamicResource FloatBarForeground}"/>
                </Grid>
                <Grid x:Name="BorderThickness2" Width="34" Height="32" Background="Transparent"
                      MouseUp="ThicknessButton_MouseUp" ToolTip="笔粗细：2.5">
                    <Border x:Name="Thickness2Highlight" CornerRadius="4" Margin="1"
                            Background="Transparent" BorderBrush="Transparent" BorderThickness="1.5"/>
                    <Ellipse x:Name="ThicknessDot2" Width="6.5" Height="6.5" Fill="{DynamicResource FloatBarForeground}"/>
                    <Border x:Name="ThicknessBar2" Visibility="Collapsed" Width="16" Height="6"
                            CornerRadius="2" Background="{DynamicResource FloatBarForeground}"/>
                </Grid>
                <Grid x:Name="BorderThickness3" Width="34" Height="32" Background="Transparent"
                      MouseUp="ThicknessButton_MouseUp" ToolTip="笔粗细：4（中）">
                    <Border x:Name="Thickness3Highlight" CornerRadius="4" Margin="1"
                            Background="Transparent" BorderBrush="Transparent" BorderThickness="1.5"/>
                    <Ellipse x:Name="ThicknessDot3" Width="9" Height="9" Fill="{DynamicResource FloatBarForeground}"/>
                    <Border x:Name="ThicknessBar3" Visibility="Collapsed" Width="16" Height="9"
                            CornerRadius="2" Background="{DynamicResource FloatBarForeground}"/>
                </Grid>
                <Grid x:Name="BorderThickness4" Width="34" Height="32" Background="Transparent"
                      MouseUp="ThicknessButton_MouseUp" ToolTip="笔粗细：6">
                    <Border x:Name="Thickness4Highlight" CornerRadius="4" Margin="1"
                            Background="Transparent" BorderBrush="Transparent" BorderThickness="1.5"/>
                    <Ellipse x:Name="ThicknessDot4" Width="12" Height="12" Fill="{DynamicResource FloatBarForeground}"/>
                    <Border x:Name="ThicknessBar4" Visibility="Collapsed" Width="16" Height="12"
                            CornerRadius="2" Background="{DynamicResource FloatBarForeground}"/>
                </Grid>
                <Grid x:Name="BorderThickness5" Width="34" Height="32" Background="Transparent"
                      MouseUp="ThicknessButton_MouseUp" ToolTip="笔粗细：9（最粗）">
                    <Border x:Name="Thickness5Highlight" CornerRadius="4" Margin="1"
                            Background="Transparent" BorderBrush="Transparent" BorderThickness="1.5"/>
                    <Ellipse x:Name="ThicknessDot5" Width="15" Height="15" Fill="{DynamicResource FloatBarForeground}"/>
                    <Border x:Name="ThicknessBar5" Visibility="Collapsed" Width="16" Height="16"
                            CornerRadius="2" Background="{DynamicResource FloatBarForeground}"/>
                </Grid>
            </UniformGrid>

            <!-- 分隔线 -->
            <Border Height="1" Background="{DynamicResource FloatBarForeground}" Opacity="0.2" Margin="2,6,2,6"/>

            <!-- ===== 分区三：颜色（两行五列 = 9 预设色 + 1 自定义色格，列宽与粗细区对齐）=====
                 七色体系 = 纯色色相网格（红0° 橙30° 黄60° 绿120° 青180° 蓝~220° 品红~292°），
                 排列仍按色相渐变（黑打头、白领下行首、自定义收尾）：
                   上行：黑 → 红 → 橙 → 黄 → 绿
                   下行：白 → 青 → 蓝 → 品红 → ＋
                 纯色 = 高饱和的标准色相，鲜艳且间隔均匀；亮度按背景适配（见 MW_WhiteboardControls.SetColors）。
                 【实现要点】每个格子的 Tag 与色点名（ColorDotN/ColorRingN）是"逻辑索引"，
                 与摆放位置解耦——重排只挪 XAML 位置，不改逻辑索引：
                 设置持久化、快捷色条映射、SelectPenColorByIndex 全部不受影响。
                 Tag 0~4 前 5 色由 MainWindow 注入（支持 Colors\*.ini 自定义配色）；
                 Tag 5 白 / Tag 6 橙 / Tag 7 品红 / Tag 8 青为固定色；Tag 9 自定义色格 -->
            <UniformGrid Rows="2" Columns="5">
                <Grid Width="34" Height="26" Background="Transparent" MouseUp="ColorDot_MouseUp" Tag="0" ToolTip="画笔颜色：黑色">
                    <Ellipse x:Name="ColorDot0" Width="15" Height="15" Fill="Black"/>
                    <Ellipse x:Name="ColorRing0" Visibility="Collapsed" Width="20" Height="20"
                             Stroke="{DynamicResource HighlightBrush}" StrokeThickness="1.5" Fill="Transparent"/>
                </Grid>
                <Grid Width="34" Height="26" Background="Transparent" MouseUp="ColorDot_MouseUp" Tag="1" ToolTip="画笔颜色：红色">
                    <Ellipse x:Name="ColorDot1" Width="15" Height="15" Fill="Red"/>
                    <Ellipse x:Name="ColorRing1" Visibility="Collapsed" Width="20" Height="20"
                             Stroke="{DynamicResource HighlightBrush}" StrokeThickness="1.5" Fill="Transparent"/>
                </Grid>
                <Grid Width="34" Height="26" Background="Transparent" MouseUp="ColorDot_MouseUp" Tag="6" ToolTip="画笔颜色：橙色（纯橙 #FF7F00）">
                    <Ellipse x:Name="ColorDot6" Width="15" Height="15" Fill="#FFFF7F00"/>
                    <Ellipse x:Name="ColorRing6" Visibility="Collapsed" Width="20" Height="20"
                             Stroke="{DynamicResource HighlightBrush}" StrokeThickness="1.5" Fill="Transparent"/>
                </Grid>
                <Grid Width="34" Height="26" Background="Transparent" MouseUp="ColorDot_MouseUp" Tag="4" ToolTip="画笔颜色：黄色">
                    <Ellipse x:Name="ColorDot4" Width="15" Height="15" Fill="Yellow"/>
                    <Ellipse x:Name="ColorRing4" Visibility="Collapsed" Width="20" Height="20"
                             Stroke="{DynamicResource HighlightBrush}" StrokeThickness="1.5" Fill="Transparent"/>
                </Grid>
                <Grid Width="34" Height="26" Background="Transparent" MouseUp="ColorDot_MouseUp" Tag="2" ToolTip="画笔颜色：绿色">
                    <Ellipse x:Name="ColorDot2" Width="15" Height="15" Fill="Green"/>
                    <Ellipse x:Name="ColorRing2" Visibility="Collapsed" Width="20" Height="20"
                             Stroke="{DynamicResource HighlightBrush}" StrokeThickness="1.5" Fill="Transparent"/>
                </Grid>
                <Grid Width="34" Height="26" Background="Transparent" MouseUp="ColorDot_MouseUp" Tag="5" ToolTip="画笔颜色：白色">
                    <!-- 白点加细灰描边：浅色面板上不隐身（沿用浮动条原方案） -->
                    <Ellipse x:Name="ColorDot5" Width="15" Height="15" Fill="White" Stroke="#80808080" StrokeThickness="1"/>
                    <Ellipse x:Name="ColorRing5" Visibility="Collapsed" Width="20" Height="20"
                             Stroke="{DynamicResource HighlightBrush}" StrokeThickness="1.5" Fill="Transparent"/>
                </Grid>
                <Grid Width="34" Height="26" Background="Transparent" MouseUp="ColorDot_MouseUp" Tag="8" ToolTip="画笔颜色：青色（纯青 #00D5D5）">
                    <Ellipse x:Name="ColorDot8" Width="15" Height="15" Fill="#FF00D5D5"/>
                    <Ellipse x:Name="ColorRing8" Visibility="Collapsed" Width="20" Height="20"
                             Stroke="{DynamicResource HighlightBrush}" StrokeThickness="1.5" Fill="Transparent"/>
                </Grid>
                <Grid Width="34" Height="26" Background="Transparent" MouseUp="ColorDot_MouseUp" Tag="3" ToolTip="画笔颜色：蓝色">
                    <Ellipse x:Name="ColorDot3" Width="15" Height="15" Fill="Blue"/>
                    <Ellipse x:Name="ColorRing3" Visibility="Collapsed" Width="20" Height="20"
                             Stroke="{DynamicResource HighlightBrush}" StrokeThickness="1.5" Fill="Transparent"/>
                </Grid>
                <Grid Width="34" Height="26" Background="Transparent" MouseUp="ColorDot_MouseUp" Tag="7" ToolTip="画笔颜色：品红（紫红 #E040FB）">
                    <Ellipse x:Name="ColorDot7" Width="15" Height="15" Fill="#FFE040FB"/>
                    <Ellipse x:Name="ColorRing7" Visibility="Collapsed" Width="20" Height="20"
                             Stroke="{DynamicResource HighlightBrush}" StrokeThickness="1.5" Fill="Transparent"/>
                </Grid>
                <!-- 第 10 格：自定义颜色（未设置=虚线圆＋号；选色后落格）。
                     交互（触屏友好）：已设置时单击直接应用该色（像预设色一样一步到位），
                     长按约 0.6 秒 或 右键 = 重新打开取色板换色（手写板没有右键，用长按）；
                     未设置时单击即打开取色板 -->
                <Grid Width="34" Height="26" Background="Transparent"
                      MouseDown="CustomColorDot_MouseDown" MouseUp="ColorDot_MouseUp"
                      MouseLeave="CustomColorDot_MouseLeave" MouseRightButtonUp="CustomColorDot_MouseRightButtonUp" Tag="9"
                      ToolTip="自定义颜色&#10;未设置时：点击打开取色板选色（选完此格记住颜色，重启保留）&#10;已设置时：单击直接使用此颜色&#10;重新选色：长按或右键点击此格（右下角＋角标提示可换色）">
                    <Ellipse x:Name="ColorDot9" Width="15" Height="15" Fill="Transparent"
                             Stroke="{DynamicResource FloatBarForeground}" StrokeThickness="1"
                             StrokeDashArray="2 2" Opacity="0.6"/>
                    <TextBlock x:Name="CustomColorPlus" Text="＋" FontSize="11"
                               Foreground="{DynamicResource FloatBarForeground}" IsHitTestVisible="False"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <!-- 已设置颜色后的"可换色"角标：压在色点右下角的小圆底＋小加号（Office"其他颜色"惯例）。
                         提示这格不是死色——长按/右键可重新选色 -->
                    <Grid x:Name="CustomColorBadge" Visibility="Collapsed" Width="9" Height="9"
                          HorizontalAlignment="Center" VerticalAlignment="Center" Margin="7,6,0,0"
                          IsHitTestVisible="False">
                        <Ellipse Fill="White" Stroke="#FF9E9E9E" StrokeThickness="0.8"/>
                        <TextBlock Text="＋" FontSize="7.5" Foreground="#FF52525B"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Margin="0,0,0,0.5"/>
                    </Grid>
                    <Ellipse x:Name="ColorRing9" Visibility="Collapsed" Width="20" Height="20"
                             Stroke="{DynamicResource HighlightBrush}" StrokeThickness="1.5" Fill="Transparent"/>
                </Grid>
            </UniformGrid>

            <!-- 分隔线 -->
            <Border Height="1" Background="{DynamicResource FloatBarForeground}" Opacity="0.2" Margin="2,6,2,6"/>

            <!-- ===== 分区四：笔锋（尾部 / 速度 / 无，复用 Settings.Canvas.InkStyle）=====
                 仅画笔有效：荧光笔/激光笔时整区灰显禁用（SetTaperSectionEnabled） -->
            <UniformGrid x:Name="TaperSection" Rows="1" Columns="3">
                <Grid x:Name="BorderTaperEnd" Width="48" Height="28" Background="Transparent"
                      MouseUp="TaperButton_MouseUp" ToolTip="笔锋：按墨迹尾部计算&#10;起笔收笔渐细，模拟真实书写">
                    <Border x:Name="TaperEndHighlight" CornerRadius="4" Margin="1"
                            Background="Transparent" BorderBrush="Transparent" BorderThickness="1.5"/>
                    <TextBlock Text="尾部" FontSize="10" Foreground="{DynamicResource FloatBarForeground}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
                <Grid x:Name="BorderTaperSpeed" Width="48" Height="28" Background="Transparent"
                      MouseUp="TaperButton_MouseUp" ToolTip="笔锋：按书写速度计算&#10;快细慢粗，模拟真实运笔">
                    <Border x:Name="TaperSpeedHighlight" CornerRadius="4" Margin="1"
                            Background="Transparent" BorderBrush="Transparent" BorderThickness="1.5"/>
                    <TextBlock Text="速度" FontSize="10" Foreground="{DynamicResource FloatBarForeground}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
                <Grid x:Name="BorderTaperNone" Width="48" Height="28" Background="Transparent"
                      MouseUp="TaperButton_MouseUp" ToolTip="笔锋：无&#10;均匀粗细">
                    <Border x:Name="TaperNoneHighlight" CornerRadius="4" Margin="1"
                            Background="Transparent" BorderBrush="Transparent" BorderThickness="1.5"/>
                    <TextBlock Text="无" FontSize="10" Foreground="{DynamicResource FloatBarForeground}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </UniformGrid>

        </StackPanel>
    </Border>
</UserControl>
