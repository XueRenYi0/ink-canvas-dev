<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 面板底色 α=85%（217/255）。2026-09-11 由 #88(53%) 调高：
         与 Light.xaml 对齐成同一个 α（原来浅 62% / 深 53% 不对称），
         同时把桌面批注时背后内容透出的对比度压到 1.4:1 以下（看不见）。 -->
    <SolidColorBrush x:Key="FloatBarBackground" Color="#D9000000"/>
    <SolidColorBrush x:Key="FloatBarBorderBrush" Color="#BFcccccc"/>
    <SolidColorBrush x:Key="FloatBarForeground" Color="#cccccc"/>
    <Color x:Key="FloatBarForegroundColor">#FFcccccc</Color>
</ResourceDictionary>