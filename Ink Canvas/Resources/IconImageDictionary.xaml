<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--旋转箭头图标（Fluent arrow_clockwise）：仅环形箭头，度数文字在 MainWindow.xaml 中以 TextBlock 叠加（跟随主题变色）-->
    <!--Rotate45/15/90 共用同一箭头几何，区别仅在叠加的度数文字-->
    <DrawingImage x:Key="Rotate45DrawingImage">
        <DrawingImage.Drawing>
            <DrawingGroup ClipGeometry="M0,0 V24 H24 V0 H0 Z">
                <GeometryDrawing Brush="{DynamicResource FloatBarForeground}" Geometry="F1 M24,24z M0,0z M12 4.5a7.5 7.5 0 1 0 7.42 6.4c-.07-.46.26-.9.72-.9.37 0 .7.26.76.62q.1.67.1 1.38a9 9 0 1 1-3-6.7V4.24a.75.75 0 0 1 1.5 0v3c0 .41-.34.75-.75.75h-3a.75.75 0 0 1 0-1.5h1.35a7.5 7.5 0 0 0-5.1-2" />
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>
    <DrawingImage x:Key="Rotate15DrawingImage">
        <DrawingImage.Drawing>
            <DrawingGroup ClipGeometry="M0,0 V24 H24 V0 H0 Z">
                <GeometryDrawing Brush="{DynamicResource FloatBarForeground}" Geometry="F1 M24,24z M0,0z M12 4.5a7.5 7.5 0 1 0 7.42 6.4c-.07-.46.26-.9.72-.9.37 0 .7.26.76.62q.1.67.1 1.38a9 9 0 1 1-3-6.7V4.24a.75.75 0 0 1 1.5 0v3c0 .41-.34.75-.75.75h-3a.75.75 0 0 1 0-1.5h1.35a7.5 7.5 0 0 0-5.1-2" />
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>
    <DrawingImage x:Key="Rotate90DrawingImage">
        <DrawingImage.Drawing>
            <DrawingGroup ClipGeometry="M0,0 V24 H24 V0 H0 Z">
                <GeometryDrawing Brush="{DynamicResource FloatBarForeground}" Geometry="F1 M24,24z M0,0z M12 4.5a7.5 7.5 0 1 0 7.42 6.4c-.07-.46.26-.9.72-.9.37 0 .7.26.76.62q.1.67.1 1.38a9 9 0 1 1-3-6.7V4.24a.75.75 0 0 1 1.5 0v3c0 .41-.34.75-.75.75h-3a.75.75 0 0 1 0-1.5h1.35a7.5 7.5 0 0 0-5.1-2" />
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>
    <!--水平翻转图标（Fluent flip_horizontal），替换原自绘翻转图标-->
    <DrawingImage x:Key="FlipDrawingImage">
        <DrawingImage.Drawing>
            <DrawingGroup ClipGeometry="M0,0 V24 H24 V0 H0 Z">
                <GeometryDrawing Brush="{DynamicResource FloatBarForeground}" Geometry="F1 M24,24z M0,0z M21.88 19.66a.8.8 0 0 1-.63.34h-7.5a.75.75 0 0 1-.75-.75V2.75a.75.75 0 0 1 1.43-.31l7.5 16.5c.1.23.09.5-.05.72M14.5 6.2V18.5h5.59zM2.5 20a.5.5 0 0 1-.45-.71l8-17a.5.5 0 0 1 .95.21v17a.5.5 0 0 1-.5.5z" />
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>
    <!--垂直翻转图标（Fluent flip_vertical），新增：原代码用 RotateTransform 旋转水平图标实现，现改为独立矢量图标-->
    <DrawingImage x:Key="FlipVerticalDrawingImage">
        <DrawingImage.Drawing>
            <DrawingGroup ClipGeometry="M0,0 V24 H24 V0 H0 Z">
                <GeometryDrawing Brush="{DynamicResource FloatBarForeground}" Geometry="F1 M24,24z M0,0z M19.66 2.12c.21.14.34.38.34.63v7.5c0 .41-.34.75-.75.75H2.75a.75.75 0 0 1-.31-1.43l16.5-7.5c.23-.1.5-.09.72.05M6.2 9.5H18.5V3.91zM20 21.5a.5.5 0 0 1-.71.45l-17-8A.5.5 0 0 1 2.5 13h17c.28 0 .5.22.5.5z" />
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>
    <!--刷新/重画图标（Fluent arrow_clockwise），替换原 Android Material 风格刷新箭头-->
    <DrawingImage x:Key="AndroidRefreshDrawingImage">
        <DrawingImage.Drawing>
            <DrawingGroup ClipGeometry="M0,0 V24 H24 V0 H0 Z">
                <GeometryDrawing Brush="{DynamicResource FloatBarForeground}" Geometry="F1 M24,24z M0,0z M12 4.5a7.5 7.5 0 1 0 7.42 6.4c-.07-.46.26-.9.72-.9.37 0 .7.26.76.62q.1.67.1 1.38a9 9 0 1 1-3-6.7V4.24a.75.75 0 0 1 1.5 0v3c0 .41-.34.75-.75.75h-3a.75.75 0 0 1 0-1.5h1.35a7.5 7.5 0 0 0-5.1-2" />
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>
</ResourceDictionary>
